<Window x:Class="MW3RemasterLauncher.ControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Controller setup — Core Critical" Width="880" Height="750" MinWidth="760" MinHeight="680"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BrushGround}" Foreground="{DynamicResource BrushInk}"
        FontFamily="{DynamicResource FontBody}" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style TargetType="DataGridCell"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#252B2B"/><Setter Property="Foreground" Value="#C4C4BE"/>
            <Setter Property="Padding" Value="8,8"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CONTROLLER SETUP" FontFamily="{DynamicResource FontDisplay}" FontSize="22"/>
            <TextBlock Text="Test and calibrate your device. Calibration is shared across games." Margin="0,8,0,12" TextWrapping="Wrap"/>
            <TextBlock Text="Use MW3 bindings to configure gameplay for a compatible native runtime. This setup window only tests input."
                       Foreground="{DynamicResource BrushAmber}" TextWrapping="Wrap" Margin="0,0,0,18"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <TextBlock Text="Connected controller" Margin="0,0,0,6"/>
            <ComboBox x:Name="Devices" SelectionChanged="DeviceChanged" AutomationProperties.Name="Connected controller"/>
            <TextBlock x:Name="IdentityNotice" Foreground="{DynamicResource BrushMuted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="Buttons" Text="Buttons: —" TextWrapping="Wrap" MinHeight="32" Margin="0,0,0,8"/>
        <DataGrid Grid.Row="3" x:Name="Axes" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" SelectionMode="Single" SelectionChanged="AxisChanged" Background="#181D1D" Foreground="#EEE6DC"
                  RowBackground="#181D1D" AlternatingRowBackground="#1E2424" BorderBrush="#373B3A" GridLinesVisibility="None">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Axis" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Raw input" Binding="{Binding Raw}" Width="*"/>
                <DataGridTextColumn Header="Adjusted" Binding="{Binding Adjusted}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" x:Name="Tuning" IsEnabled="False" Margin="0,14,0,12">
            <TextBlock x:Name="AxisTitle" Text="Select an axis to tune it" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="65"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Text="Deadzone" VerticalAlignment="Center"/>
                <Slider Grid.Column="1" x:Name="Deadzone" Minimum="0" Maximum="0.45" Value="0.12" ValueChanged="Tune" AutomationProperties.Name="Axis deadzone"/>
                <TextBlock Grid.Column="2" x:Name="DeadzoneLabel" HorizontalAlignment="Right"/>
                <TextBlock Grid.Row="1" Text="Response" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <Slider Grid.Row="1" Grid.Column="1" x:Name="Response" Minimum="0.25" Maximum="4" Value="1" ValueChanged="Tune" Margin="0,10,0,0" AutomationProperties.Name="Axis response"/>
                <TextBlock Grid.Row="1" Grid.Column="2" x:Name="ResponseLabel" HorizontalAlignment="Right" Margin="0,10,0,0"/>
            </Grid>
            <CheckBox x:Name="Invert" Content="Invert this axis" Checked="InvertChanged" Unchecked="InvertChanged" Margin="0,10,0,12"/>
            <WrapPanel>
                <Button x:Name="Calibrate" Content="Start calibration" Click="StartCalibration"/>
                <Button x:Name="Next" Content="Measure full range" Click="NextCalibration" IsEnabled="False"/>
                <Button x:Name="Save" Content="Save calibration" Click="SaveCalibration"/>
            </WrapPanel>
        </StackPanel>
        <DockPanel Grid.Row="5">
            <Button DockPanel.Dock="Right" Content="MW3 bindings…" Click="OpenBindings" VerticalAlignment="Bottom"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="CloseWindow" Margin="16,0,0,0" VerticalAlignment="Bottom"/>
            <TextBlock x:Name="Status" Text="Looking for controllers…" TextWrapping="Wrap" Foreground="{DynamicResource BrushAmber}" MinHeight="42"/>
        </DockPanel>
    </Grid>
</Window>
